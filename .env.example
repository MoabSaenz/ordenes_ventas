# Copia este archivo como .env.local y completa los valores necesarios.
# No guardes contrasenas ni claves reales en GitHub.
SECRET_KEY=pon-aqui-una-clave-larga-y-privada
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Denver

# SQLite es el motor predeterminado. DB_NAME puede omitirse en ese caso.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Para MySQL, sustituye las variables anteriores por:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=ordenes_ventas
# DB_USER=usuario_mysql
# DB_PASSWORD=contrasena_mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
